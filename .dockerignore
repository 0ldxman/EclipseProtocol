# Everything the image does not need. `old/` alone is several hundred megabytes
# of reference material with its own node_modules, and sending it to the daemon
# would dominate the build time.

node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo

old
.git
.github
.dev-screenshots
tools/geo

# Mutable state and pipeline intermediates - but keep the baked topology, which
# is what the map actually serves.
data/*
!data/runtime
!data/geo-detail

Dockerfile
.dockerignore
docker-compose.yml
