# SQLite file holding record/category/links/record_access - editable at
# runtime through the admin endpoints (require a JWT with is_admin: true).
DATABASE_PATH=aether_wiki.db

# Where aether-auth publishes its RS256 public key (see auth/README.md).
# Fetched once at startup and cached - no per-request network call.
AUTH_JWT_PUBLIC_KEY_URL=http://localhost:8000/.well-known/jwt-public-key
JWT_ISSUER=aether-auth
JWT_AUDIENCE=aether-services
