# Discord Developer Portal -> your application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# The single Discord guild that defines org membership/roles
DISCORD_GUILD_ID=

# RS256 keypair (see scripts/gen_keys.sh)
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=aether-auth
JWT_AUDIENCE=aether-services
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# SQLite file holding organizations/org_roles/permissions/admin_roles -
# editable at runtime via /admin/console, no restart needed.
DATABASE_PATH=aether_auth.db

# Random secret used to sign the OAuth2 "state" param (CSRF protection)
OAUTH_STATE_SECRET=change-me-to-a-random-secret

COOKIE_DOMAIN=
COOKIE_SECURE=true
# "lax" — если фронт и auth на одном origin (например через rewrites Next.js).
# "none" — если фронт на ДРУГОМ домене (требует COOKIE_SECURE=true, иначе
# браузер откажется ставить такую куку).
COOKIE_SAMESITE=lax

# Публичный URL фронта-админки. Если задан, /auth/callback после успешного
# входа через Discord редиректит сюда (вместо возврата голого JSON).
ADMIN_URL=

# Разрешённые CORS-origin'ы через запятую. Нужно заполнить, если ADMIN_URL —
# домен, отличный от того, что проксирует запросы к этому сервису (см.
# CORS_ORIGINS + COOKIE_SAMESITE=none в паре).
CORS_ORIGINS=

# Опционально: локальный вход в админку по паролю (без Discord).
# Если задан — включается POST /auth/login-password, выдающий admin-токен.
ADMIN_PASSWORD=
