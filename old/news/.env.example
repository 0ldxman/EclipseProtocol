# Скопируйте этот файл в .env и при необходимости измените значения.
# Все переменные опциональны: без них сервис работает в открытом dev-режиме.

# --- База ---
# DATABASE_URL=sqlite:///./news.db

# --- API ---
# Ключ для доступа к API (заголовок X-API-Key). Пусто = API открыт.
# NEWS_API_KEY=

# --- Роли и доступ ---
# Режим авторизации:
#   open    — разработка: роль берётся из DEV_ROLE, вход не требуется
#   discord — вход через Discord, роль по ролям на сервере
# AUTH_MODE=open

# В режиме open форсирует роль для тестов: admin | user
# DEV_ROLE=admin

# Видна ли лента анонимам (без входа). true/false
# FEED_PUBLIC=true

# Секрет для подписи cookie-сессий. ОБЯЗАТЕЛЬНО задайте в проде
# (иначе при каждом перезапуске все разлогиниваются).
# SESSION_SECRET=поставьте_длинную_случайную_строку

# --- Discord OAuth (нужно для AUTH_MODE=discord) ---
# Создаётся в Discord Developer Portal -> ваше приложение -> OAuth2.
# В Redirects добавьте тот же URL, что и в DISCORD_REDIRECT_URI.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ID вашего сервера (Guild) и ID роли, дающей права админа:
# DISCORD_GUILD_ID=
# DISCORD_ADMIN_ROLE_ID=
# DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# --- Discord (отправка новостей) ---
# DISCORD_TIMEOUT=10

# --- Прочее ---
# APP_TITLE=Центр новостей
